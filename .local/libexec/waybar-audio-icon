#!/usr/bin/env python3

import json
import re
import subprocess
import sys


target = sys.argv[1] if len(sys.argv) > 1 else ""
if target not in ("sink", "source"):
    raise SystemExit("usage: waybar-audio-icon sink|source")

kind, icon_off, icon_low, icon_mid, icon_high = (
    ("sink", "\uf6a9", "\uf026", "\uf027", "\uf028")
    if target == "sink"
    else ("source", "\uf131", "\uf130", "\uf130", "\uf130")
)


def pactl(*args):
    return subprocess.run(
        ["pactl", *args], check=True, capture_output=True, text=True
    ).stdout


try:
    volume_text = pactl(f"get-{kind}-volume", f"@DEFAULT_{target.upper()}@")
    volume = int(re.search(r"(\d+)%", volume_text).group(1))
    muted = pactl(f"get-{kind}-mute", f"@DEFAULT_{target.upper()}@").strip().endswith("yes")
except (subprocess.CalledProcessError, AttributeError, ValueError):
    volume = 0
    muted = True

icon = icon_off if muted else icon_low if volume < 34 else icon_mid if volume < 67 else icon_high
label = "Output" if target == "sink" else "Input"
print(json.dumps({
    "text": f"<span font_family='Font Awesome 6 Free'>{icon}</span>",
    "tooltip": f"{label} muted" if muted else f"{label} volume: {volume}%",
    "class": f"{target}-muted" if muted else f"{target}-volume",
}))
