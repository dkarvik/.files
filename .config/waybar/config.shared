{
    "layer": "top",
    "position": "top",
    "height": 45,
    "spacing": 10,
    "margin-top": 10,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left":["niri/workspaces"],
    "modules-center":["niri/window"],
    "modules-right": ["group/status", "clock", "tray"],
    "group/status": {
        "orientation": "inherit",
        "modules": ["pulseaudio", "network", "backlight", "battery"]
    },
    "tray": {
        "icon-size": 20,
        "spacing": 10
    },
    "clock": {
        "format": "{:%c}",
        "format-alt": "{:%F %R}"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}% {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "   {volume}%",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%"
    },
    "network": {
        "format-wifi": "{essid} ({signalStrength}%) ",
        "tooltip-format-wifi": "{frequency}GHz {bandwidthUpBytes}/{bandwidthDownBytes}",
        "format-ethernet": "{ifname}: {ipaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}"
    },
    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": ["", ""],
        "on-scroll-up": "xbacklight -inc 1",
        "on-scroll-down": "xbacklight -dec 1",
        "on-click": "wrap-brightness",
        "on-click-right": "xbacklight -dec 15",
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "custom/keyboard": {
        "format": "",
        "on-click": "pkill -SIGRTMIN wvkbd-mobintl"
    }
}
