{
    "layer": "top",
    "position": "top",
    "height": 45,
    "spacing": 10,
    "margin-top": 10,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left":["niri/workspaces"],
    "modules-center":["niri/window"],
    "modules-right": ["group/status", "clock", "tray"],
    "group/status": {
        "orientation": "inherit",
        "modules": ["pulseaudio", "network", "backlight", "battery"]
    },
    "tray": {
        "icon-size": 20,
        "spacing": 10
    },
    "clock": {
        "format": "{:%c}",
        "format-alt": "{:%F %R}"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}% {format_source}",
        "format-bluetooth": "{volume}% {icon}<span font_family='Font Awesome 6 Brands'></span> {format_source}",
        "format-bluetooth-muted": "<span font_family='Font Awesome 6 Free'></span> {icon}<span font_family='Font Awesome 6 Brands'></span> {format_source}",
        "format-muted": "<span font_family='Font Awesome 6 Free'></span> {format_source}",
        "format-source": "  <span font_family='Font Awesome 6 Free'></span> {volume}%",
        "format-source-muted": "<span font_family='Font Awesome 6 Free'></span>",
        "format-icons": {
            "headphone": "<span font_family='Font Awesome 6 Free'></span>",
            "hands-free": "<span font_family='Font Awesome 6 Free'></span>",
            "headset": "<span font_family='Font Awesome 6 Free'></span>",
            "phone": "<span font_family='Font Awesome 6 Free'></span>",
            "portable": "<span font_family='Font Awesome 6 Free'></span>",
            "car": "<span font_family='Font Awesome 6 Free'></span>",
            "default": ["<span font_family='Font Awesome 6 Free'></span>", "<span font_family='Font Awesome 6 Free'></span>", "<span font_family='Font Awesome 6 Free'></span>"]
        },
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%"
    },
    "network": {
        "format-wifi": "{essid} ({signalStrength}%) <span font_family='Font Awesome 6 Free'></span>",
        "tooltip-format-wifi": "{frequency}GHz {bandwidthUpBytes}/{bandwidthDownBytes}",
        "format-ethernet": "{ifname}: {ipaddr} <span font_family='Font Awesome 6 Free'></span>",
        "format-linked": "{ifname} (No IP) <span font_family='Font Awesome 6 Free'></span>",
        "format-disconnected": "Disconnected <span font_family='Font Awesome 6 Free'></span>",
        "format-alt": "{ifname}: {ipaddr}"
    },
    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": ["<span font_family='Font Awesome 6 Free'></span>", "<span font_family='Font Awesome 6 Free'></span>"],
        "on-scroll-up": "xbacklight -inc 1",
        "on-scroll-down": "xbacklight -dec 1",
        "on-click": "wrap-brightness",
        "on-click-right": "xbacklight -dec 15",
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% <span font_family='Font Awesome 6 Free'></span>",
        "format-plugged": "{capacity}% <span font_family='Font Awesome 6 Free'></span>",
        "format-alt": "{time} {icon}",
        "format-icons": ["<span font_family='Font Awesome 6 Free'></span>", "<span font_family='Font Awesome 6 Free'></span>", "<span font_family='Font Awesome 6 Free'></span>", "<span font_family='Font Awesome 6 Free'></span>", "<span font_family='Font Awesome 6 Free'></span>"]
    },
    "custom/keyboard": {
        "format": "<span font_family='Font Awesome 6 Free'></span>",
        "on-click": "pkill -SIGRTMIN wvkbd-mobintl"
    }
}
